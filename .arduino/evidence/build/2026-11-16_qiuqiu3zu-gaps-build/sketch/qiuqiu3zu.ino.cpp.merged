#include <Servo.h>
// Vendor cycle, 3 groups with one-pin gaps so 3-wire plugs fit.
// 2-3-4 / skip 5 / 6-7-8 / skip 9 / 10-11-12
// 180 = ON, 0 = OFF. Auto 3 cycles in setup(), then stop.
Servo servo_2;
Servo servo_3;
Servo servo_4;
Servo servo_6;
Servo servo_7;
Servo servo_8;
Servo servo_10;
Servo servo_11;
Servo servo_12;
// Group 1: D2 inflate, D3 valve, D4 deflate
// Group 2: D6 inflate, D7 valve, D8 deflate
// Group 3: D10 inflate, D11 valve, D12 deflate

void setup() {
  servo_2.attach(2);
  servo_3.attach(3);
  servo_4.attach(4);

  servo_6.attach(6);
  servo_7.attach(7);
  servo_8.attach(8);

  servo_10.attach(10);
  servo_11.attach(11);
  servo_12.attach(12);

  for (int index = 0; index < 3; index++) {
    servo_2.write(180);
    servo_3.write(180);
    servo_4.write(0);

    servo_6.write(180);
    servo_7.write(180);
    servo_8.write(0);

    servo_10.write(180);
    servo_11.write(180);
    servo_12.write(0);

    delay(8000);

    servo_2.write(0);
    servo_3.write(0);
    servo_4.write(180);

    servo_6.write(0);
    servo_7.write(0);
    servo_8.write(180);

    servo_10.write(0);
    servo_11.write(0);
    servo_12.write(180);

    delay(8000);

    servo_2.write(0);
    servo_3.write(0);
    servo_4.write(0);

    servo_6.write(0);
    servo_7.write(0);
    servo_8.write(0);

    servo_10.write(0);
    servo_11.write(0);
    servo_12.write(0);
  }
}

void loop() {
}

